#. module: mysargal_pos
msgid "%(client)s a %(pts)s points — aucune récompense disponible pour l'instant."
msgstr "%(client)s has %(pts)s points — no reward available yet."

#. module: mysargal_pos
msgid "%(reward)s appliquée — %(pts)s points utilisés, il reste %(rest)s."
msgstr "%(reward)s applied — %(pts)s points used, %(rest)s left."

#. module: mysargal_pos
msgid "Ajoute d'abord les articles au ticket. Aucun point n'a été débité."
msgstr "Add the items to the receipt first. No points were deducted."

#. module: mysargal_pos
msgid "Aucune carte MySargal trouvée pour ce code ni pour ce numéro."
msgstr "No MySargal card found for this code or this number."

#. module: mysargal_pos
msgid "Carte %(code)s — solde %(balance)s, appliqué %(amount)s"
msgstr "Card %(code)s — balance %(balance)s, applied %(amount)s"

#. module: mysargal_pos
msgid "Carte cadeau"
msgstr "Gift card"

#. module: mysargal_pos
msgid "Carte cadeau MySargal"
msgstr "MySargal gift card"

#. module: mysargal_pos
msgid "Carte de fidélité"
msgstr "Loyalty card"

#. module: mysargal_pos
msgid "Carte introuvable."
msgstr "Card not found."

#. module: mysargal_pos
msgid "Carte inutilisable : "
msgstr "Card unusable: "

#. module: mysargal_pos
msgid "Cette carte n'a plus de solde."
msgstr "This card has no balance left."

#. module: mysargal_pos
msgid "Code de la carte ou numéro de téléphone du client."
msgstr "Card code or customer phone number."

#. module: mysargal_pos
msgid "Débit impossible : "
msgstr "Charge failed: "

#. module: mysargal_pos
msgid "Débit refusé : "
msgstr "Charge refused: "

#. module: mysargal_pos
msgid "Débit refusé."
msgstr "Charge refused."

#. module: mysargal_pos
msgid "Fermer"
msgstr "Close"

#. module: mysargal_pos
msgid "Fidélité"
msgstr "Loyalty"

#. module: mysargal_pos
msgid "Impossible de lire la carte : "
msgstr "Could not read the card: "

#. module: mysargal_pos
msgid "LC-XXXXXX ou 77 000 00 00"
msgstr "LC-XXXXXX or 77 000 00 00"

#. module: mysargal_pos
msgid "La remise n'a pas pu être ajoutée au ticket. Aucun point n'a été débité."
msgstr "The discount could not be added to the receipt. No points were deducted."

#. module: mysargal_pos
msgid "Le produit de remise est introuvable dans cette caisse. Aucun point n'a été débité : redémarre Odoo puis mets à jour le module MySargal Caisse."
msgstr "The discount product is missing from this point of sale. No points were deducted: restart Odoo then update the MySargal Point of Sale module."

#. module: mysargal_pos
msgid "MySargal"
msgstr "MySargal"

#. module: mysargal_pos
msgid "MySargal : +%(pts)s points pour %(client)s"
msgstr "MySargal: +%(pts)s points for %(client)s"

#. module: mysargal_pos
msgid "OK"
msgstr "OK"

#. module: mysargal_pos
msgid "Récompense"
msgstr "Reward"

#. module: mysargal_pos
msgid "Récompenses disponibles"
msgstr "Available rewards"

#. module: mysargal_pos
msgid "Saisissez ou scannez le code de la carte."
msgstr "Type or scan the card code."

#. module: mysargal_pos
msgid "Solde insuffisant sur la carte."
msgstr "Not enough balance on the card."

#. module: mysargal_pos
msgid "Vérification impossible : "
msgstr "Check failed: "

#. module: mysargal_pos
msgid "Le produit de remise est introuvable dans cette caisse. Aucun point n'a été débité : redémarre Odoo puis mets à jour le module MySargal Caisse."
msgstr "The discount product is missing from this point of sale. No points were deducted: restart Odoo then update the MySargal Point of Sale module."
