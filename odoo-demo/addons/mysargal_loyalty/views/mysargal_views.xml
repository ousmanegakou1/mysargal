<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Produit : case "Carte cadeau MySargal" -->
  <record id="product_template_form_mysargal" model="ir.ui.view">
    <field name="name">product.template.form.mysargal</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <field name="list_price" position="after">
        <field name="x_mysargal_giftcard"/>
      </field>
    </field>
  </record>

  <!-- Commande : numéro WhatsApp du bénéficiaire -->
  <record id="sale_order_form_mysargal" model="ir.ui.view">
    <field name="name">sale.order.form.mysargal</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="x_mysargal_gift_phone" placeholder="+221 77 123 45 67"/>
      </field>
    </field>
  </record>

</odoo>
